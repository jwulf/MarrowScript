{
  "name": "MarrowScript",
  "scopeName": "source.marrow",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#declarations" },
    { "include": "#operators" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.marrow", "match": "//.*$" },
        { "name": "comment.block.marrow", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.marrow", "begin": "\"", "end": "\"", "patterns": [
          { "name": "constant.character.escape.marrow", "match": "\\\\." }
        ]}
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.duration.marrow", "match": "\\b\\d+(ms|s|m|h|d)\\b" },
        { "name": "constant.numeric.float.marrow", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.marrow", "match": "\\b\\d+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.marrow",
          "match": "\\b(system|entity|capability|channel|store|event|constraint|policy|flow|import|from|model|prompt|router|extension_point)\\b"
        },
        {
          "name": "keyword.other.marrow",
          "match": "\\b(owns|constraints|states|auth|relation|index|derived|requires|effects|emits|sync|timeout|retry|idempotent|transport|ordering|participants|persistence|filter|max_size|engine|schema|retention|partition|replicas|payload|delivery|ttl|rate_limit|access|audit|encryption|step|compensate|per|domain|cognition|provider|endpoint|template|tier|validate|on_invalid|cache|tools|confidence_threshold|on_low_confidence|fallback|context_window|max_output|temperature|top_p|stop|cost_class|latency_class|vram_mb|quant)\\b"
        },
        {
          "name": "keyword.operator.logical.marrow",
          "match": "\\b(and|or|not|in|contains|using|by)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.marrow",
          "match": "\\b(string|uint|int|float|bool|timestamp|uuid|bytes|json)\\b"
        },
        {
          "name": "support.type.generic.marrow",
          "match": "\\b(set|list|map|optional|result)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "entity.name.type.marrow",
          "match": "(?<=\\b(system|entity|store|event|channel|policy|flow|capability|model|prompt|router|extension_point)\\s+)\\w+"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.marrow", "match": "->" },
        { "name": "keyword.operator.comparison.marrow", "match": "(==|!=|<=|>=|<|>)" },
        { "name": "keyword.operator.assignment.marrow", "match": "(\\+=|-=|<<=|=)" },
        { "name": "keyword.operator.range.marrow", "match": "\\.\\." }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.marrow", "match": "\\b(true|false|none)\\b" },
        {
          "name": "constant.language.enum.marrow",
          "match": "\\b(jwt|oauth2|apikey|session|websocket|sse|polling|grpc_stream|causal|fifo|total|unordered|postgresql|redis|mongodb|sqlite|s3|dynamodb|at_least_once|at_most_once|exactly_once|at_rest|in_transit|both|realtime|eventual|batch|transactional|has_one|has_many|belongs_to|many_to_many|full|ollama|openai_compat|llamacpp|koboldcpp|http|tiny|small|medium|large|fast|slow|none|schema_only|ast_compiles|fail|escalate|retry_with_repair_prompt|exponential|linear|fixed)\\b"
        }
      ]
    }
  }
}
