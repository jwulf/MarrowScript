# --- Dependencies ------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# --- Build outputs -----------------------------------------------------------
# compiler/dist/ is built on demand by the `prepare` lifecycle hook, so local
# installs of file:../compiler in lsp/ and vscode-ext/ trigger `npm run build`
# automatically. Published npm tarballs are built by `prepublishOnly`.
compiler/dist/
lsp/dist/
vscode-ext/out/
*.js.map
*.d.ts.map

# --- Compiled JS/DTS artifacts in src/ (should only be in dist/) ------------
# These appear when ts-node or tsc emits into the source directory by mistake.
compiler/src/*.js
compiler/src/*.d.ts
compiler/src/**/*.js
compiler/src/**/*.d.ts

# --- Generated output (marrowc compile produces this) -----------------------
examples/*/output/
examples/output/
examples/output-sqlite/
examples/output-nakama/
examples/output-prisma/

# --- Test scratch files ------------------------------------------------------
examples/test_*.marrow
examples/test_*.bone
examples/marketplace/run_tests.ts

# --- VS Code extension packages (compiled binaries) -------------------------
*.vsix

# --- Python scripts used during development ---------------------------------
lsp/src/gen_server*.py
compiler/src/*.py

# --- Environment files -------------------------------------------------------
.env
.env.local
.env.*.local
# Generated project .env files (contain local DB credentials and secrets)
examples/**/.env
examples/**/output/.env
examples/marketplace/output/.env
TEST/output/.env
TEST/**/.env

# --- Runtime state files (generated at runtime, not source) ----------------
TEST/output/.frontend_token
TEST/output/.last_trace_id
TEST/output/.bonec_replay.ts
**/.bonec_replay.ts
traces/

# --- MarrowForge runtime caches ---------------------------------------------
# Phase 9 repo-clone sandbox + Phase 12 on-disk ForgeResult save target.
.forge-cache/
TEST/output/.forge-cache/
**/.forge-cache/

# --- node_modules (all subdirectories) --------------------------------------
TEST/output/node_modules/
TEST/artifact_check/node_modules/
TEST/ui/node_modules/
TEST/packages/**/node_modules/

# --- MarrowForge UI build artifacts -----------------------------------------
TEST/ui/dist/
TEST/ui/*.tsbuildinfo

# --- Playground (internal dev tool, not part of the public repo) ------------
Playground/

# --- Internal IDE/tool databases (not part of the project source) -----------
.code-graph/
.memory/
.kiro/settings/

# --- Logs --------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS files ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editor files ------------------------------------------------------------
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo

# --- TypeScript cache --------------------------------------------------------
*.tsbuildinfo

# --- Coverage ----------------------------------------------------------------
coverage/
.nyc_output/
