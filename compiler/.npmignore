# MarrowScript compiler — npm publish ignore
# Only dist/, src/ (minus tests), LICENSE, and README ship in the tarball.
# The "files" field in package.json is the primary allowlist; this file
# acts as a safety net to exclude anything that slips through.

# --- Tests (source and compiled) ---
src/tests/
dist/tests/

# --- Development scripts ---
src/*.py
tsconfig.json

# --- Build tooling ---
node_modules/
.tsbuildinfo

# --- Git and editor ---
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- CI/CD ---
.github/

# --- Logs ---
*.log
npm-debug.log*

# --- Coverage ---
coverage/
.nyc_output/

# --- Package lock (consumers use their own) ---
package-lock.json
